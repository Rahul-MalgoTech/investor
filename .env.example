NODE_ENV=development
PORT=5001

# MongoDB Atlas connection string.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/criket_1?retryWrites=true&w=majority&appName=criket_1

# Comma-separated Flutter/web origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

OTP_TTL_MINUTES=10
OTP_LENGTH=6
PHONE_DUMMY_OTP=123456

# SMTP details for email OTP. Fill these with the SMTP values you will provide.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_google_app_password
SMTP_FROM="Investor <yourgmail@gmail.com>"

# Google auth. Use the web/client ID configured in Google Cloud/Firebase.
GOOGLE_CLIENT_ID=1072360802587-e3hsauccnqofbhgk3bogk9unlbj4ets7.apps.googleusercontent.com
